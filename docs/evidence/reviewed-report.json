  "sourceFiles": {
    "reviewed.build": "# BootLens authored review fixture, not a board-qualified boot image.\n# No QNX boot or mkifs build is claimed by this static demonstration.\n[virtual=x86_64,bios] .bootstrap = {\n    startup-x86\n    PATH=/proc/boot:/bin:/usr/bin\n    procnto-smp-instr\n}\n[+script] .startup = {\n    display_msg \"BootLens reviewed scenario\"\n    devc-con -n2 &\n    waitfor /dev/con1 5\n    reopen /dev/con1\n    [+session] /bin/shell -l &\n}\nlibc.so\nlibgcc_s.so.1\n/usr/lib/ldqnx-64.so.2=ldqnx-64.so.2\ndevc-con\n/bin/shell=esh\n/usr/bin/observer=observer-v2\n"
  },
