{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "BootLens",
          "version": "1.0.0",
          "informationUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html",
          "rules": [
            {
              "id": "BL001",
              "name": "Malformedstructure",
              "shortDescription": {
                "text": "Malformed structure"
              },
              "help": {
                "text": "Repair unmatched attributes or an unterminated inline file."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL002",
              "name": "Analysisboundary",
              "shortDescription": {
                "text": "Analysis boundary"
              },
              "help": {
                "text": "Resolve the indicated include, variable, external script or unsupported construct before treating coverage as complete."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL010",
              "name": "Nobootstrapinspected",
              "shortDescription": {
                "text": "No bootstrap inspected"
              },
              "help": {
                "text": "If this is a bootable image, provide its virtual bootstrap. Nonbootable images may intentionally omit it."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL011",
              "name": "Bootstrapplacement",
              "shortDescription": {
                "text": "Bootstrap placement"
              },
              "help": {
                "text": "Place the bootfile before every other file specification."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL012",
              "name": "Bootstraporder",
              "shortDescription": {
                "text": "Bootstrap order"
              },
              "help": {
                "text": "The first executable must be startup-* and the last executable must be procnto*."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL013",
              "name": "Multiplebootfiles",
              "shortDescription": {
                "text": "Multiple bootfiles"
              },
              "help": {
                "text": "Only one virtual bootfile may be specified."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL020",
              "name": "Conflictingimageentry",
              "shortDescription": {
                "text": "Conflicting image entry"
              },
              "help": {
                "text": "Give each explicitly declared target path a single definition."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL021",
              "name": "Scriptexecutablenotdeclared",
              "shortDescription": {
                "text": "Script executable not declared"
              },
              "help": {
                "text": "Add the executable to the image, or verify the filesystem supplying it is available before this command."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL022",
              "name": "Shellsyntaxinstartupscript",
              "shortDescription": {
                "text": "Shell syntax in startup script"
              },
              "help": {
                "text": "mkifs startup scripts are not general shell scripts. Invoke an included shell explicitly when shell features are needed."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL023",
              "name": "Foregroundresourcemanager",
              "shortDescription": {
                "text": "Foreground resource manager"
              },
              "help": {
                "text": "A long-running foreground process can prevent later startup commands. Review whether this resource manager should run in the background."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL024",
              "name": "Temporaryfilesystemcaveat",
              "shortDescription": {
                "text": "Temporary filesystem caveat"
              },
              "help": {
                "text": "A /tmp link to /dev/shmem is not a complete filesystem. Use an appropriate filesystem for a production deployment."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            },
            {
              "id": "BL025",
              "name": "Runtimelinkerpathnotdeclared",
              "shortDescription": {
                "text": "Runtime linker path not declared"
              },
              "help": {
                "text": "For dynamically linked programs, check that /usr/lib/ldqnx-64.so.2 is provided or linked to the runtime linker. This check does not inspect ELF dependencies."
              },
              "helpUri": "https://qnx.com/developers/docs/8.0/com.qnx.doc.neutrino.utilities/topic/m/mkifs.html"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "BL011",
          "level": "error",
          "message": {
            "text": "Bootfile follows another image file specification."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL012",
          "level": "error",
          "message": {
            "text": "Bootstrap must begin with startup-* and end with procnto*."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL024",
          "level": "warning",
          "message": {
            "text": "/tmp links to /dev/shmem."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL020",
          "level": "error",
          "message": {
            "text": "Duplicate target /usr/bin/observer First declared at broken.build:16."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 17
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL021",
          "level": "warning",
          "message": {
            "text": "Executable is not explicitly declared in this image: devc-con It may come from an external filesystem or automatic expansion; verify its availability at this point."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL023",
          "level": "warning",
          "message": {
            "text": "Review foreground resource manager: devc-con"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 10
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL021",
          "level": "warning",
          "message": {
            "text": "Executable is not explicitly declared in this image: /bin/shell It may come from an external filesystem or automatic expansion; verify its availability at this point."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 13
                }
              }
            }
          ]
        },
        {
          "ruleId": "BL025",
          "level": "note",
          "message": {
            "text": "Expected QNX 8.0 runtime linker path is not explicitly declared. This may be intentional for static executables or an externally supplied filesystem."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "broken.build"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
